{
  "name": "prayertimeappexpo",
  "version": "1.0.0",
  "description": "Cross-platform Prayer Time App",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android": "expo run:android",
    "build:ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "doctor": "npx expo-doctor",
    "lint": "eslint .",
    "start:clear": "expo start --clear",
    "typecheck": "tsc --noEmit",
    "deps:check": "expo install --check",
    "verify": "npm run deps:check && npm run doctor && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.3.0",
    "@react-navigation/native": "^7.1.0",
    "expo": "^56.0.8",
    "expo-asset": "~56.0.0",
    "expo-constants": "~56.0.0",
    "expo-font": "~56.0.0",
    "expo-linking": "~56.0.0",
    "expo-location": "~56.0.0",
    "expo-navigation-bar": "~56.0.0",
    "expo-notifications": "~56.0.0",
    "expo-sensors": "~56.0.0",
    "expo-splash-screen": "~56.0.0",
    "expo-status-bar": "~56.0.0",
    "expo-updates": "~56.0.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "^56.0.4",
    "playwright": "^1.60.0",
    "puppeteer": "^24.43.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
